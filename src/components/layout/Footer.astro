---
---

<footer class="bg-navy text-white">
  <!-- Main footer -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10">

    <!-- Brand col -->
    <div class="lg:col-span-1">
      <div class="mb-4 flex items-center gap-3">
        <img
          src="/images/club-logo.webp"
          alt=""
          width="88"
          height="88"
          class="w-20 h-20 object-contain rounded bg-white"
          loading="lazy"
          decoding="async"
        />
        <div>
          <div class="font-display font-black text-white text-2xl tracking-tight leading-none">CHARLES MICHAEL</div>
          <div class="font-display font-semibold text-red-brand text-base tracking-widest uppercase">Sports Hub</div>
        </div>
      </div>
      <p class="font-body text-sm text-blue-100 leading-relaxed mb-4">
        A sports hub in Limuru, Kiambu County, Kenya, creating opportunities to train, compete and grow. Taekwondo is our flagship programme.
      </p>
      <!-- Social links (placeholders) -->
      <div class="flex gap-3">
        <a href="[PLACEHOLDER_FACEBOOK_URL]" aria-label="Facebook" class="text-blue-200 hover:text-white transition-colors">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/>
          </svg>
        </a>
        <a href="[PLACEHOLDER_INSTAGRAM_URL]" aria-label="Instagram" class="text-blue-200 hover:text-white transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
          </svg>
        </a>
        <a href="[PLACEHOLDER_TWITTER_URL]" aria-label="Twitter / X" class="text-blue-200 hover:text-white transition-colors">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
          </svg>
        </a>
        <a href="https://wa.me/254754151315" aria-label="WhatsApp 0754 151 315" class="text-blue-200 hover:text-white transition-colors">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.125.557 4.122 1.528 5.852L.057 23.5l5.783-1.517A11.945 11.945 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22c-1.886 0-3.65-.49-5.18-1.348l-.37-.22-3.43.9.916-3.342-.24-.383A9.955 9.955 0 012 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- Quick links -->
    <div>
      <h3 class="font-display font-bold text-xl mb-5 uppercase tracking-wide">Quick Links</h3>
      <ul class="space-y-2 font-body text-sm">
        {[
          ['Home', '/'],
          ['About Us', '/about'],
          ['Programmes', '/programmes'],
          ['Mount Kenya International Taekwondo Open', '/open-2027'],
          ['Sponsors', '/sponsors'],
          ['Pathway', '/pathway'],
          ['News', '/news'],
          ['Contact', '/contact'],
        ].map(([label, href]) => (
          <li>
            <a href={href} class="text-blue-200 hover:text-white transition-colors hover:underline">{label}</a>
          </li>
        ))}
      </ul>
    </div>

    <!-- Contact -->
    <div>
      <h3 class="font-display font-bold text-xl mb-5 uppercase tracking-wide">Contact</h3>
      <ul class="space-y-3 font-body text-sm text-blue-100">
        <li class="flex gap-2 items-start">
          <svg class="w-4 h-4 mt-0.5 flex-shrink-0 text-red-brand" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
          <span>[PLACEHOLDER: Physical Address], Limuru, Kiambu County, Kenya</span>
        </li>
        <li class="flex gap-2 items-center">
          <svg class="w-4 h-4 flex-shrink-0 text-red-brand" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          <a href="tel:+254754151315" class="hover:text-white transition-colors">0754 151 315</a>
        </li>
        <li class="flex gap-2 items-center">
          <svg class="w-4 h-4 flex-shrink-0 text-red-brand" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
          <a href="mailto:info@[PLACEHOLDER_DOMAIN]" class="hover:text-white transition-colors">info@[PLACEHOLDER_DOMAIN]</a>
        </li>
        <li class="mt-4">
          <p class="text-xs text-blue-300">Opening hours:</p>
          <p>[PLACEHOLDER: Training hours and days]</p>
        </li>
      </ul>
    </div>

    <!-- Legal & newsletter -->
    <div>
      <h3 class="font-display font-bold text-xl mb-5 uppercase tracking-wide">Legal & Safety</h3>
      <ul class="space-y-2 font-body text-sm mb-6">
        {[
          ['Safeguarding Policy', '/safeguarding'],
          ['Privacy Policy', '/privacy'],
          ['Terms of Use', '/terms'],
          ['Cookie Notice', '/cookies'],
        ].map(([label, href]) => (
          <li>
            <a href={href} class="text-blue-200 hover:text-white transition-colors hover:underline">{label}</a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="border-t border-navy-light">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-5 flex flex-col sm:flex-row justify-between items-center gap-3">
      <p class="font-body text-xs text-blue-200 text-center sm:text-left">
        &copy; {new Date().getFullYear()} Charles Michael Sports Hub. All rights reserved.
      </p>
      <p class="font-body text-xs text-blue-300 text-center">
        <a href="/safeguarding" class="underline hover:text-white">Safeguarding</a> &nbsp;|&nbsp;
        Powered by World Taekwondo rules
        <!-- [PLACEHOLDER: Once KTF affiliation confirmed, add: | Affiliated with Kenya Taekwondo Federation] -->
      </p>
    </div>
  </div>
</footer>
