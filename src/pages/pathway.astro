---
import BaseLayout from '../layouts/BaseLayout.astro';

const steps = [
  {
    num: '01',
    title: 'Organiser meets the standard',
    who: 'Charles Michael Sports Hub',
    text: 'To be considered for inclusion on the World Taekwondo calendar, the event organiser must demonstrate the ability to run a safe, well-managed, technically correct tournament under World Taekwondo rules. That is what the Charles Michael Taekwondo Open 2027 is about. We run a world-class event in Kenya — and we prove it.',
  },
  {
    num: '02',
    title: 'Application goes through the National Federation',
    who: 'Kenya Taekwondo Federation (KTF)',
    text: 'World Taekwondo does not deal directly with individual clubs or academies. All applications for recognised events must be submitted by the national federation — in Kenya\'s case, the Kenya Taekwondo Federation (KTF). CMSH works with KTF as our host and support. KTF is the applicant and the registered body.',
  },
  {
    num: '03',
    title: 'World Taekwondo reviews and grants recognition',
    who: 'World Taekwondo',
    text: 'WT reviews the application, which covers venue standards, event management capability, anti-doping procedures, safety, and officiating. Recognition is not guaranteed and is not automatically renewed — it must be earned each cycle.',
  },
  {
    num: '04',
    title: 'The international open is hosted',
    who: 'CMSH + KTF + WT',
    text: 'If recognition is granted, the event — we call it the Charles Michael International Open at that point — becomes part of the World Taekwondo international calendar. Kenyan athletes and athletes from recognised nations can earn WT ranking points by competing here. This is the long-term goal.',
  },
];
---

<BaseLayout
  title="International Pathway"
  description="How Charles Michael Sports Hub is working toward a World Taekwondo–recognised international open in Kenya — through the Kenya Taekwondo Federation."
>

  <!-- Hero -->
  <section class="bg-navy text-white py-24" style="clip-path: polygon(0 0, 100% 0, 100% 88%, 0 100%);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="section-subtitle text-red-brand mb-3">The Big Picture</p>
      <h1 class="font-display font-black text-7xl md:text-8xl text-white leading-none mb-6">The International<br/>Pathway</h1>
      <p class="font-body text-blue-100 text-xl max-w-2xl leading-relaxed">
        How a club in Limuru can put Kenya on the World Taekwondo international calendar — and why it takes more than ambition.
      </p>
    </div>
  </section>

  <!-- Honest framing -->
  <section class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 reveal">
      <div class="bg-bluegrey border-l-4 border-navy p-8 rounded-r-xl">
        <h2 class="font-display font-bold text-3xl text-navy mb-4">An Honest Overview</h2>
        <p class="font-body text-gray-700 text-lg leading-relaxed mb-4">
          World Taekwondo recognition is the gold standard for any open tournament. It means the event is on the international calendar, athletes earn ranking points by competing, and the event is subject to WT quality standards.
        </p>
        <p class="font-body text-gray-700 text-lg leading-relaxed mb-4">
          It is not a simple process. It cannot be applied for directly by a private academy. It requires the support of the national federation, a proven track record of event management, and meeting World Taekwondo's infrastructure requirements.
        </p>
        <p class="font-body text-gray-700 text-lg leading-relaxed">
          We are at the beginning of that process. We are clear about where we are on that path — and clear about where we are going.
        </p>
      </div>
    </div>
  </section>

  <!-- Timeline -->
  <section class="py-20 bg-bluegrey">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14 reveal">
        <p class="section-subtitle">Step by Step</p>
        <h2 class="section-title">How It Works</h2>
      </div>
      <div class="relative">
        <!-- Vertical line -->
        <div class="absolute left-8 top-0 bottom-0 w-0.5 bg-red-brand/30 hidden sm:block"></div>
        <div class="space-y-10">
          {steps.map((step, i) => (
            <div class="flex gap-8 items-start reveal" style={`transition-delay: ${i * 120}ms`}>
              <!-- Number -->
              <div class="flex-shrink-0 w-16 h-16 rounded-full bg-red-brand text-white flex items-center justify-center font-display font-black text-2xl shadow-lg z-10">
                {step.num}
              </div>
              <!-- Content -->
              <div class="card p-8 flex-1">
                <p class="font-body text-xs text-gray-400 uppercase tracking-widest mb-1">{step.who}</p>
                <h3 class="font-display font-bold text-3xl text-navy mb-4">{step.title}</h3>
                <p class="font-body text-gray-600 text-lg leading-relaxed">{step.text}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Context: WT Under-21 -->
  <section class="py-20 bg-navy text-white text-center">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 reveal">
      <p class="section-subtitle text-red-brand">Kenya's Moment</p>
      <h2 class="font-display font-black text-6xl text-white mb-6">The Context</h2>
      <p class="font-body text-blue-100 text-xl leading-relaxed mb-6">
        In December 2025, Nairobi hosted the first World Taekwondo Under-21 Championships — 452 athletes from 75 nations. Kenya showed the world it can host at the highest level.
      </p>
      <p class="font-body text-blue-100 text-xl leading-relaxed mb-10">
        Charles Michael Sports Hub is building on that moment. We are not claiming to be the next big thing. We are doing the work — class by class, tournament by tournament — to become it.
      </p>
      <a href="/about" class="btn-secondary text-xl px-8 py-4">Read Our Story →</a>
    </div>
  </section>

  <!-- Important note on naming -->
  <section class="py-14 bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 reveal">
      <div class="bg-bluegrey border-l-4 border-red-brand p-8 rounded-r-xl">
        <h3 class="font-display font-bold text-2xl text-navy mb-3">A Note on Event Names</h3>
        <p class="font-body text-gray-700 leading-relaxed">
          We call our current event the <strong>Charles Michael Taekwondo Open</strong>. Our long-term aspiration is the <strong>Charles Michael International Open</strong>. We will never use the word "World" or the abbreviation "WT" in an event name without formal World Taekwondo authorisation. We do not claim recognition we have not yet received.
        </p>
      </div>
    </div>
  </section>

</BaseLayout>
